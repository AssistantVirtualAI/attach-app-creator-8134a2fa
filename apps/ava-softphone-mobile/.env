VITE_NATIVE_SIP=true

# ICE/STUN configuration — use reliable public STUN servers
# pbxnode.lemtel.tel:3478 is NOT accessible externally (UDP port blocked/filtered)
# Google STUN responds in ~10ms, Cloudflare in ~15ms
VITE_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302,stun:stun.cloudflare.com:3478
# No TURN servers — FreeSWITCH uses direct RTP, STUN srflx candidates are sufficient
# VITE_TURN_URLS=

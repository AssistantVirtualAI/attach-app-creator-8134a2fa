VITE_NATIVE_SIP=true

# ICE/STUN configuration — use FusionPBX STUN server directly (port 3478 confirmed open)
# This avoids relying on Metered.ca TURN servers which are unreachable from mobile networks
VITE_STUN_URLS=stun:pbxnode.lemtel.tel:3478,stun:stun.l.google.com:19302
# No TURN servers — FreeSWITCH uses direct RTP, STUN srflx candidates are sufficient
# VITE_TURN_URLS=

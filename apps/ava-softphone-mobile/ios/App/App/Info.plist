<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>AVA Softphone</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>

	<!-- Privacy usage strings (App Store required) -->
	<key>NSMicrophoneUsageDescription</key>
	<string>AVA Softphone uses the microphone so you can speak during phone calls. / AVA Softphone utilise le microphone pour vous permettre de parler pendant vos appels.</string>
	<key>NSContactsUsageDescription</key>
	<string>Planiprêt / AVA Softphone accède à vos contacts pour identifier vos appelants et les associer à vos dossiers clients. Vos contacts sont téléversés de façon sécurisée sur nos serveurs uniquement à cette fin et ne sont jamais partagés avec des tiers. Vous pouvez révoquer cet accès en tout temps dans les Réglages de votre iPhone ou depuis « Plus → Supprimer mes contacts du serveur ». / Planiprêt / AVA Softphone accesses your contacts to identify incoming callers and match them with your client files. Your contacts are securely uploaded to our servers for this purpose only and are never shared with third parties. You can revoke this access at any time in iPhone Settings or from "More → Delete my contacts from server".</string>

	<key>NSPhotoLibraryUsageDescription</key>
	<string>AVA Softphone uses photos only when you choose a profile picture. / AVA Softphone accède aux photos uniquement lorsque vous choisissez une photo de profil.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>AVA Softphone needs local network access to establish your SIP phone calls. / AVA Softphone a besoin du réseau local pour établir vos appels SIP.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_sip._tcp</string>
		<string>_sip._udp</string>
	</array>
	<key>NSUserNotificationsUsageDescription</key>
	<string>AVA Softphone uses notifications to alert you about missed calls, voicemails, and new messages. / AVA Softphone utilise les notifications pour vous prévenir des appels manqués, messages vocaux et SMS.</string>

	<!-- Encryption export compliance -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!-- WebKit / WebRTC for SIP -->
	<key>WKAppBoundDomains</key>
	<array>
		<string>pbxnode.lemtel.tel</string>
		<string>lemtel.lemtel.tel</string>
		<string>node.lemtelcloud.net</string>
	</array>
	<key>WebKitICECandidateFilteringEnabled</key>
	<false/>
	<key>WebKitEnumeratingAllNetworkInterfacesEnabled</key>
	<true/>

	<!-- Background modes: audio + VoIP push (PushKit) for incoming calls when app is in background/terminated -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>remote-notification</string>
		<string>voip</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.lemtel.softphone.sip-refresh</string>
	</array>
	<key>UIRequiresPersistentWiFi</key>
	<true/>


	<!-- App-to-app schemes used by click-to-call fallbacks -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>tel</string>
		<string>sms</string>
		<string>mailto</string>
	</array>

	<!-- Register URL schemes this app handles.
	     tel:   → iOS Recents/Contacts tap opens app and auto-dials
	     avastatistic: → deep-link for auto-login token -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.lemtel.softphone.tel</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>tel</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.lemtel.softphone</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>avastatistic</string>
			</array>
		</dict>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>AVA Softphone uses the camera to scan QR codes for quick SIP account configuration.</string>
</dict>
</plist>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Lemtel</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>

	<!-- Privacy usage strings. Lemtel is powered by AVA. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Lemtel, powered by AVA, uses the microphone so you can speak during phone calls. / Lemtel, propulsé par AVA, utilise le microphone pour vous permettre de parler pendant vos appels.</string>
	<key>NSContactsUsageDescription</key>
	<string>Lemtel, powered by AVA, accesses contacts only after your in-app consent to help with dialing and caller identification. Manage permission in iPhone Settings. / Lemtel, propulsé par AVA, accède aux contacts seulement après votre consentement dans l’application pour faciliter la composition et identifier les appelants. Gérez cette permission dans les Réglages de l’iPhone.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Lemtel, powered by AVA, uses photos only when you choose a profile picture. / Lemtel, propulsé par AVA, accède aux photos uniquement lorsque vous choisissez une photo de profil.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Lemtel, powered by AVA, needs local network access to establish authorized SIP phone calls. / Lemtel, propulsé par AVA, a besoin du réseau local pour établir les appels SIP autorisés.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_sip._tcp</string>
		<string>_sip._udp</string>
	</array>
	<key>NSUserNotificationsUsageDescription</key>
	<string>Lemtel, powered by AVA, uses notifications to alert you about missed calls, voicemails, and new messages. / Lemtel, propulsé par AVA, utilise les notifications pour vous prévenir des appels manqués, messages vocaux et SMS.</string>
	<key>NSCameraUsageDescription</key>
	<string>Lemtel, powered by AVA, uses the camera to scan QR codes for authorized account configuration. / Lemtel, propulsé par AVA, utilise la caméra pour numériser des codes QR de configuration de compte autorisée.</string>

	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!-- Hostinger Auth is explicitly allowed. SIP/PBX endpoints remain unchanged until FusionPBX test details are approved. -->
	<key>WKAppBoundDomains</key>
	<array>
		<string>lemtel.avastatistic.ca</string>
		<string>pbxnode.lemtel.tel</string>
		<string>lemtel.lemtel.tel</string>
		<string>node.lemtelcloud.net</string>
	</array>
	<key>WebKitICECandidateFilteringEnabled</key>
	<false/>
	<key>WebKitEnumeratingAllNetworkInterfacesEnabled</key>
	<true/>

	<!-- Incoming-call behavior remains gated by verified PushKit, CallKit, APNs and PBX testing. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>remote-notification</string>
		<string>voip</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.lemtel.softphone.sip-refresh</string>
	</array>

	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>tel</string>
		<string>sms</string>
		<string>mailto</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.lemtel.softphone.tel</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>tel</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.lemtel.softphone</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>avastatistic</string>
			</array>
		</dict>
	</array>
</dict>
</plist>

{
	"appId": "com.planipret.mobile",
	"appName": "Planiprêt Mobile",
	"webDir": "dist",
	"server": {
		"androidScheme": "https"
	},
	"ios": {
		"allowsLinkPreview": false,
		"scrollEnabled": false,
		"contentInset": "automatic",
		"preferredContentMode": "mobile",
		"webContentsDebuggingEnabled": false
	},
	"plugins": {
		"CapacitorHttp": {
			"enabled": false
		},
		"SplashScreen": {
			"launchAutoHide": true,
			"launchShowDuration": 0,
			"launchFadeOutDuration": 0,
			"backgroundColor": "#0A1425",
			"showSpinner": false
		},
		"StatusBar": {
			"style": "light"
		},
		"PushNotifications": {
			"presentationOptions": [
				"badge",
				"sound",
				"alert"
			]
		},
		"LocalNotifications": {
			"smallIcon": "ic_stat_planipret",
			"iconColor": "#2E9BDC"
		}
	},
	"packageClassList": [
		"BluetoothLe",
		"ContactsPlugin",
		"AppPlugin",
		"CAPBrowserPlugin",
		"CAPCameraPlugin",
		"DevicePlugin",
		"FilesystemPlugin",
		"HapticsPlugin",
		"LocalNotificationsPlugin",
		"CAPNetworkPlugin",
		"PreferencesPlugin",
		"PushNotificationsPlugin",
		"SplashScreenPlugin",
		"StatusBarPlugin",
		"CapacitorUpdaterPlugin"
	]
}

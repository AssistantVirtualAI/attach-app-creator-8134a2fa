{
  "contract_version": "lemtel_device_test_readiness_v1",
  "profile": "hostinger-staging",
  "purpose": "private_device_test_only",
  "backend": {
    "origin_must_be": "https://lemtel.avastatistic.ca",
    "configuration_filter_required": "lemtel-hostinger-client-config-filter.mjs"
  },
  "android": {
    "artifact": "debug_apk",
    "emulator_smoke_required": true,
    "release_signing": false,
    "public_distribution": false
  },
  "ios": {
    "artifact": "unsigned_device_compile",
    "physical_installation_blocked_until": ["apple_development_or_distribution_signing", "provisioning_profile", "named_test_device_or_testflight"],
    "app_store_upload": false
  },
  "desktop_macos": {
    "artifact": "unsigned_private_package",
    "physical_installation_blocked_until": ["owner_accepts_manual_test_installation_or_notarized_test_build"],
    "auto_update": false,
    "public_distribution": false
  },
  "required_before_real_call_test": [
    "named_test_extension",
    "sip_wss_turn_values_from_fusionpbx_test_tenant",
    "test_device_owner_consent",
    "call_test_plan"
  ],
  "forbidden": [
    "Planipret", "Lovable_current_project", "production_release", "release_signing",
    "app_store_or_play_store_upload", "desktop_auto_update", "FusionPBX_mutation",
    "DNS_change", "DigitalOcean_standby_start"
  ]
}

# Installed and started only by the agent control script. No Install section: the boot start exists only in
# permanent mode, as an explicit timers.target.wants link created by `start_permanent` and removed by `stop`.
[Unit]
Description=Lemtel Hostinger failover agent timer (explicit start only)

[Timer]
OnActiveSec=60s
OnUnitInactiveSec=60s
AccuracySec=5s
Persistent=false
Unit=lemtel-ha-hostinger-failover-agent.service

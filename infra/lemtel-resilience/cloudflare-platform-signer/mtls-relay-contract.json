{
  "contract_version": "lemtel_cloudflare_platform_signer_mtls_relay_v2",
  "scope": "source_only_machine_identity_alternative",
  "status": "design_review_required_not_deployable",
  "purpose": "authenticate a dedicated root-only relay to the existing Access-protected platform signer for node_enrollment_publication_delivery only",
  "identity": {
    "mechanism": "cloudflare_access_mutual_tls_service_auth",
    "dedicated_client_identity_required": true,
    "reuse_node_or_platform_key_forbidden": true,
    "source_ip_authentication_forbidden": true,
    "access_policy_action": "service_auth",
    "access_policy_selector": "common_name_exact",
    "access_application_default_deny": true,
    "access_user_policy_allowed": false
  },
  "implementation": {
    "source_available": true,
    "source_only": true,
    "production_deployment_authorized": false,
    "network_listener_type": "unix_socket_only",
    "fixed_signer_hostname": "signer.lemtel.assistantvirtualai.com",
    "fixed_signer_path": "/v1/node-enrollment-delivery",
    "root_only_systemd_template_without_install_section": true
  },
  "local_relay": {
    "root_only_service_required": true,
    "edge_container_direct_certificate_access_forbidden": true,
    "unix_socket_only_required": true,
    "container_network_listener_forbidden": true,
    "local_peer_authorization_required": true,
    "unauthorized_peer_denied_before_network": true,
    "socket_owner_mode_and_mount_boundary_test_required": true,
    "fixed_signer_origin_required": true,
    "fixed_purpose_required": "node_enrollment_publication_delivery",
    "arbitrary_url_or_method_forbidden": true,
    "arbitrary_signing_oracle_forbidden": true,
    "outbound_network_before_local_authorization_forbidden": true,
    "request_size_max_bytes": 6144,
    "max_concurrent_requests": 1,
    "rate_limit_window_seconds": 60,
    "rate_limit_max_requests": 3,
    "local_timeout_seconds_max": 3,
    "outbound_timeout_seconds_max": 5,
    "uncertain_result_retry_forbidden": true,
    "unambiguous_local_unavailable_result": true,
    "response_request_binding_required": true,
    "stale_socket_verified_cleanup_required": true,
    "service_installed": false,
    "service_enabled": false,
    "socket_created": false,
    "client_certificate_generated": false,
    "client_private_key_stored": false
  },
  "signer": {
    "private_platform_key_remains_cloudflare_write_only": true,
    "worker_secret_binding_created": false,
    "signing_endpoint_configured": false,
    "replay_ledger_configured": false,
    "node_enrollment_integration_configured": false
  },
  "required_before_any_deployment": [
    "independent_security_review",
    "root_only_credential_backend_with_encrypted_at_rest_attestation",
    "dedicated_client_certificate_rotation_and_revocation_test",
    "cloudflare_access_mtls_common_name_policy_test",
    "unix_socket_container_isolation_test",
    "local_peer_authorization_test",
    "socket_owner_mode_and_mount_boundary_test",
    "request_size_timeout_and_rate_limit_test",
    "canonical_request_nonce_ttl_and_durable_replay_ledger_test",
    "negative_test_without_certificate_or_with_wrong_common_name",
    "edge_enrollment_redaction_and_timeout_attestation"

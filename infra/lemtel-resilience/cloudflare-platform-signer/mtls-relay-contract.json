  "activation": {
    "node_enrollment": false,
    "node_publisher": false,
    "provider_fencing": false,
    "automatic_promotion": false,
    "automatic_runtime_start": false,
    "automatic_traffic_routing": false,
    "automatic_failover": false,
    "automatic_failback": false

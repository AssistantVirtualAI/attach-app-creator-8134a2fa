[Unit]
Description=Lemtel Hostinger standby signed resource publisher (not enrolled)
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/local/libexec/lemtel-hostinger-standby-resource-publisher/publish.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run

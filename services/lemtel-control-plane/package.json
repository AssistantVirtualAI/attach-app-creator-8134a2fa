{
  "name": "lemtel-control-plane",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "test": "tsx --test test/*.test.ts",
    "migrate": "node dist/src/migrations.js",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "fastify": "5.12.5",
    "pg": "8.16.3",
    "redis": "5.8.3"
  },
  "devDependencies": {
    "@types/node": "22.18.8",
    "@types/pg": "8.15.5",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
